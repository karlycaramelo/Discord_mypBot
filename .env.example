# Copia este archivo como .env y llena los valores.
# El archivo .env NUNCA se sube al repositorio.

# Token del bot (Discord Developer Portal > tu aplicación > Bot > Reset Token)
DISCORD_TOKEN=

# ID del canal donde el bot responderá (clic derecho en el canal > Copiar ID del canal)
DISCORD_CHANNEL_ID=

# Opcional: ID del servidor para que el comando aparezca de inmediato durante las pruebas
DISCORD_GUILD_ID=

# Proveedor de respuestas: ficticio u openai
PROVEEDOR_CHAT=ficticio

# Consultas permitidas por usuario mientras el bot esté encendido (se reinicia al reiniciar el bot)
LIMITE_CONSULTAS_POR_USUARIO=5

# Solo se necesitan cuando PROVEEDOR_CHAT=openai
OPENAI_API_KEY=
OPENAI_MODEL=
